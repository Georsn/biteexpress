rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'items', 'subtotal', 'deliveryFee', 'total', 'address', 'paymentMethod', 'status', 'createdAt'])
        && data.keys().size() >= 9
        && data.id is string
        && data.id.size() <= 128
        && data.subtotal is number
        && data.deliveryFee is number
        && data.total is number
        && data.address is map
        && data.paymentMethod is string
        && data.status is string
        && data.createdAt is string;
    }

    // Orders Collection Rules
    match /orders/{orderId} {
      allow get: if isValidId(orderId);
      allow list: if false; // Secure from query scraping
      
      allow create: if isValidId(orderId) 
        && isValidOrder(incoming()) 
        && incoming().id == orderId;
        
      allow update: if isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().id == existing().id
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
        
      allow delete: if false;
    }
  }
}
